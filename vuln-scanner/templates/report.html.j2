<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vulnerability Scan Report — {{ meta.target }}</title>
<style>
  :root {
    --bg: #0f1117; --surface: #1a1d27; --border: #2e3147;
    --text: #e2e8f0; --muted: #8892a4; --accent: #60a5fa;
    --red: #f87171; --orange: #fb923c; --yellow: #fbbf24;
    --cyan: #22d3ee; --green: #4ade80; --gray: #6b7280;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: 'Segoe UI', system-ui, sans-serif; font-size: 14px; line-height: 1.6; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }

  /* Layout */
  .container { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem; }

  /* Cover */
  .cover { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 2.5rem; margin-bottom: 2rem; }
  .cover h1 { font-size: 1.8rem; color: var(--accent); margin-bottom: 0.25rem; }
  .cover .subtitle { color: var(--muted); margin-bottom: 1.5rem; font-size: 0.9rem; }
  .summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .stat-card { background: var(--bg); border: 1px solid var(--border); border-radius: 6px; padding: 0.75rem 1rem; text-align: center; }
  .stat-card .value { font-size: 1.6rem; font-weight: 700; }
  .stat-card .label { color: var(--muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .stat-critical .value { color: var(--red); }
  .stat-high .value { color: var(--orange); }
  .stat-medium .value { color: var(--yellow); }
  .stat-low .value { color: var(--cyan); }

  /* Meta table */
  .meta-table { width: 100%; border-collapse: collapse; margin-top: 1.25rem; }
  .meta-table td { padding: 0.3rem 0.5rem; }
  .meta-table td:first-child { color: var(--muted); width: 160px; }

  /* Host sections (CSS checkbox collapsible) */
  .host-toggle { display: none; }
  .host-header {
    background: var(--surface); border: 1px solid var(--border); border-radius: 6px;
    padding: 1rem 1.25rem; cursor: pointer; user-select: none;
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 0.5rem; transition: border-color 0.15s;
  }
  .host-header:hover { border-color: var(--accent); }
  .host-header .chevron { color: var(--muted); transition: transform 0.2s; }
  .host-toggle:checked + .host-header .chevron { transform: rotate(90deg); }
  .host-body { display: none; margin-bottom: 1.5rem; }
  .host-toggle:checked ~ .host-body { display: block; }
  .host-name { font-weight: 600; font-size: 1rem; }
  .host-meta { color: var(--muted); font-size: 0.8rem; }

  /* Services table */
  .services-table { width: 100%; border-collapse: collapse; margin-bottom: 1.5rem; }
  .services-table th { background: var(--surface); color: var(--muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.5rem 0.75rem; text-align: left; border-bottom: 1px solid var(--border); }
  .services-table td { padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--border); vertical-align: top; }
  .services-table tr:last-child td { border-bottom: none; }
  .port-num { font-family: monospace; font-weight: 600; color: var(--accent); }
  .state-open { color: var(--green); }
  .state-filtered { color: var(--yellow); }
  .state-closed { color: var(--gray); }

  /* Severity badges */
  .badge { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 3px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; }
  .badge-CRITICAL { background: #7f1d1d; color: var(--red); }
  .badge-HIGH     { background: #7c2d12; color: var(--orange); }
  .badge-MEDIUM   { background: #713f12; color: var(--yellow); }
  .badge-LOW      { background: #164e63; color: var(--cyan); }
  .badge-NONE     { background: #1f2937; color: var(--gray); }

  /* CVE list */
  .cve-list { list-style: none; font-size: 0.8rem; }
  .cve-list li { margin-bottom: 0.2rem; }
  .cve-id { font-family: monospace; }
  .cvss-score { color: var(--muted); margin-left: 0.35rem; }

  /* Confidence badge */
  .confidence { font-size: 0.7rem; color: var(--muted); font-family: monospace; }

  /* Footer */
  footer { border-top: 1px solid var(--border); margin-top: 3rem; padding-top: 1.5rem; color: var(--muted); font-size: 0.8rem; }
  footer span { margin-right: 1.5rem; }

  @media print {
    .host-body { display: block !important; }
    .host-header .chevron { display: none; }
    .host-section { page-break-inside: avoid; page-break-before: always; }
    .host-section:first-child { page-break-before: auto; }
  }
</style>
</head>
<body>
<div class="container">

  <!-- Cover -->
  <div class="cover">
    <h1>Vulnerability Scan Report</h1>
    <div class="subtitle">Generated by vuln-scanner {{ meta.scanner_version }}</div>

    <table class="meta-table">
      <tr><td>Target</td><td><strong>{{ meta.target }}</strong></td></tr>
      <tr><td>Scan started</td><td>{{ meta.scan_started }}</td></tr>
      <tr><td>Scan finished</td><td>{{ meta.scan_finished }}</td></tr>
      <tr><td>CVE DB synced</td><td>{{ meta.cve_db_synced }}</td></tr>
    </table>

    <div class="summary-grid">
      <div class="stat-card">
        <div class="value">{{ meta.summary.host_count }}</div>
        <div class="label">Hosts</div>
      </div>
      <div class="stat-card">
        <div class="value">{{ meta.summary.open_port_count }}</div>
        <div class="label">Open Ports</div>
      </div>
      <div class="stat-card stat-critical">
        <div class="value">{{ meta.summary.critical_count }}</div>
        <div class="label">Critical</div>
      </div>
      <div class="stat-card stat-high">
        <div class="value">{{ meta.summary.high_count }}</div>
        <div class="label">High</div>
      </div>
      <div class="stat-card stat-medium">
        <div class="value">{{ meta.summary.medium_count }}</div>
        <div class="label">Medium</div>
      </div>
      <div class="stat-card stat-low">
        <div class="value">{{ meta.summary.low_count }}</div>
        <div class="label">Low</div>
      </div>
    </div>
  </div>

  <!-- Per-host sections -->
  {% for host in hosts %}
  {% set loop_idx = loop.index %}
  <div class="host-section">
    <input type="checkbox" class="host-toggle" id="host-{{ loop_idx }}" checked>
    <label class="host-header" for="host-{{ loop_idx }}">
      <span>
        <span class="host-name">{{ host.scan_result.host }}</span>
        {% if host.scan_result.os_guess %}
        <span class="host-meta">  —  {{ host.scan_result.os_guess }}
          ({{ "%.0f"|format(host.scan_result.os_confidence * 100) }}% confidence)</span>
        {% endif %}
      </span>
      <span class="chevron">▶</span>
    </label>

    <div class="host-body">
      <table class="services-table">
        <thead>
          <tr>
            <th>Port</th>
            <th>Service</th>
            <th>Version</th>
            <th>CPE</th>
            <th>CVEs</th>
          </tr>
        </thead>
        <tbody>
          {% for es in host.services %}
          {% if es.service.state != 'closed' %}
          <tr>
            <td class="port-num">
              {{ es.service.port }}/{{ es.service.protocol }}
              <br><span class="state-{{ es.service.state }}">{{ es.service.state }}</span>
            </td>
            <td>{{ es.service.service_guess or '' }}</td>
            <td>{{ es.service.version_string or '' }}</td>
            <td>
              {% if es.cpe_uri %}
              <span class="confidence" title="match: {{ es.match_method }}">
                {{ es.cpe_uri }}<br>
                conf: {{ "%.0f"|format(es.cpe_confidence * 100) }}%
              </span>
              {% endif %}
            </td>
            <td>
              {% if es.cves %}
              <ul class="cve-list">
                {% for cve in es.cves %}
                <li>
                  <span class="badge badge-{{ cve.severity or 'NONE' }}">{{ cve.severity or 'N/A' }}</span>
                  <a class="cve-id" href="https://nvd.nist.gov/vuln/detail/{{ cve.cve_id }}" target="_blank" rel="noopener">{{ cve.cve_id }}</a>
                  {% if cve.cvss_score is not none %}<span class="cvss-score">{{ cve.cvss_score }}</span>{% endif %}
                </li>
                {% endfor %}
              </ul>
              {% endif %}
            </td>
          </tr>
          {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endfor %}

  <!-- Footer -->
  <footer>
    <span>vuln-scanner {{ meta.scanner_version }}</span>
    <span>Scan: {{ meta.scan_started }} → {{ meta.scan_finished }}</span>
    <span>CVE DB: {{ meta.cve_db_synced }}</span>
    <br><br>
    <em>This report is for authorized security testing only. Handle with care.</em>
  </footer>

</div>
</body>
</html>
